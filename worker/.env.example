# PostgreSQL (usa la cadena directa de Supabase o Postgres; no la URL REST).
DATABASE_URL=postgresql://usuario:clave@host:5432/postgres
DATABASE_SSL=true

# Cloudflare R2. El worker solo usa el bucket privado.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=aguaenlaboca-private

# Opcionales.
FACE_MODEL_DIR=node_modules/@vladmandic/face-api/model
WORKER_ID=
WORKER_POLL_MS=2000
WORKER_LEASE_SECONDS=300
WORKER_DB_POOL=4
